DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nse_academy_api

JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRY=7d

PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx

CMS_URL=http://localhost:1337
CMS_API_TOKEN=your-strapi-api-token

# OpenRouter (AI stock advice) - https://openrouter.ai/keys
# OPENROUTER_MODEL is optional; defaults to a free finance-oriented model.
# OpenRouter's free-tier roster changes over time, so check
# https://openrouter.ai/models?max_price=0 for current options.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Tried in order if the primary errors (free models are rate limited and get retired).
# OpenRouter allows at most 3 models in total: the primary plus 2 fallbacks.
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free,openrouter/free

# The daily public market report runs on its OWN model chain, so it can use a
# reliable low-cost paid model (about $0.0014 per report) while the stock
# advisor above stays on the free default. Chosen by testing 6 models on the real
# task: Haiku 5.5 and GPT-6 Luna both passed the number/meaning checks 2/2.
# Unset MARKET_REPORT_MODEL to fall back to the OPENROUTER_* settings.
MARKET_REPORT_MODEL=anthropic/claude-haiku-5.5
MARKET_REPORT_FALLBACK_MODELS=openai/gpt-6-luna,deepseek/deepseek-v4-flash

# Tavily (search grounding for AI stock advice) - https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key

# RapidAPI Key for NSE Market Data
RAPID_API_KEY=your_rapidapi_key

# Admin API key - used to authenticate requests from the CMS user-manager plugin
ADMIN_API_KEY=your_secret_admin_key

PORT=3011
GA_PROPERTY_ID=your-property-id
GA_CLIENT_EMAIL=your-client-email
GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Dexter file delivery API (ebook downloads)
DEXTER_API_KEY=dex_S0Zg8Rju8TMB78XdhoNann6jHiHj_8V8jFNfRVX1gfE

# Brevo (transactional email + contact sync for lead magnets / marketing).
# When BREVO_API_KEY is empty the BrevoService logs a warning and no-ops, so
# local dev works without one. Get the key + list id from app.brevo.com.
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_SENDER_EMAIL=no-reply@nseacademy.vitaldigitalmedia.net
BREVO_SENDER_NAME=NSE Academy
# Optional - Brevo template id used for the lead-magnet welcome email. When
# unset, a built-in HTML email is sent so the flow works out of the box.
BREVO_LEAD_MAGNET_TEMPLATE_ID=

# Dedicated Brevo list id used only for the admin "compose email" broadcast
# feature (nse-academy-api/src/broadcast). Separate from BREVO_LIST_ID so
# broadcast audience membership doesn't interfere with lead-nurture
# automation on that list. Create an empty list in Brevo and put its numeric
# id here - required for the broadcast feature to work.
BREVO_BROADCAST_LIST_ID=

# Public site URL used in lead-magnet email links. Defaults to the prod URL.
SITE_URL=https://nseacademy.vitaldigitalmedia.net

# Shared secret for the Brevo transactional-webhook listener
# (/webhooks/brevo?key=...) that records email opens/clicks against
# FlowEntry rows. Brevo doesn't sign these payloads, so this is the only
# thing stopping an arbitrary POST from forging engagement events - generate
# with `openssl rand -hex 32` and paste the same value into the webhook URL
# you configure in Brevo's dashboard (Transactional > Settings > Webhooks).
BREVO_WEBHOOK_SECRET=

# Admin notifications (new contact messages, payments, advisor applications,
# failed payment webhooks) and the daily 08:00 (Nairobi) report.
# Comma-separated; defaults to info@vitaldigitalmedia.net.
ADMIN_NOTIFY_EMAIL=info@vitaldigitalmedia.net
# Base URL of the Strapi admin, used for "Open in admin" links in those emails.
CMS_ADMIN_URL=https://nseacademy-admin.vitaldigitalmedia.net

# AI stock advice - optional own model chain (empty = use OPENROUTER_MODEL and its fallbacks)
# STOCK_ADVICE_MODEL=anthropic/claude-haiku-5.5
# STOCK_ADVICE_FALLBACK_MODELS=openai/gpt-6-luna
