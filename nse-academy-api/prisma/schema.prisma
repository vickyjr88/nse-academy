generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  name                String
  phone               String?
  referralCode        String               @unique @default(cuid())
  investorProfile     InvestorProfile?
  subscription        Subscription?
  ebookPurchase       EbookPurchase[]
  progress            LessonProgress[]
  referralsMade       Referral[]           @relation("ReferralsMade")
  referralReceived    Referral?            @relation("ReferralReceived")
  orgMembership       OrgMember?
  createdAt           DateTime             @default(now())
  trades              Trade[]
  holdings            Holding[]
  statementImports    StatementImport[]
  priceAlerts         PriceAlert[]
  notifications       Notification[]
  dividends           Dividend[]
  realizedGains       RealizedGain[]
  passwordResetTokens PasswordResetToken[]
  advisorProfile      AdvisorProfile?
  advisorConnections  AdvisorClient[]
  advisorQueries      AdvisorQuery[]
  tags                UserTag[]
  flowEntries         FlowEntry[]
  // Lifecycle-email dedupe flags - each nullable timestamp is set the one
  // time its email fires so the daily lifecycle cron never resends it,
  // mirroring Subscription.expiryWarningSentAt below.
  day1EmailSentAt     DateTime?
  day7EmailSentAt     DateTime?
  day14EmailSentAt    DateTime?
}

model EbookPurchase {
  id            String    @id @default(cuid())
  userId        String?
  email         String
  productId     String // Dexter product ID
  user          User?     @relation(fields: [userId], references: [id])
  reference     String    @unique
  amountKes     Int
  guestToken    String    @unique
  downloadCount Int       @default(0)
  downloadedAt  DateTime?
  emailedAt     DateTime?
  purchasedAt   DateTime  @default(now())

  @@unique([userId, productId])
  @@unique([email, productId])
  @@index([email])
}

model InvestorProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  type         String // conservative | moderate | aggressive | dividend | growth
  riskScore    Int // 0-100
  horizonYears Int
  capitalRange String // <100k | 100k-500k | 500k-2M | >2M
  quizAnswers  Json
  isPublic     Boolean  @default(false)
  publicSlug   String?  @unique
  createdAt    DateTime @default(now())
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id])
  tier             String // free | intermediary | premium
  paystackSubId    String?
  currentPeriodEnd DateTime?
  status           String // active | cancelled | past_due
  freeMonths       Int       @default(0)
  // Set when the "expiring soon" reminder email fires, so the daily cron
  // doesn't resend it every day in the run-up to expiry. Cleared whenever
  // currentPeriodEnd moves forward (renewal), so a later expiry gets its
  // own fresh warning.
  expiryWarningSentAt DateTime?
  // Set once the post-expiry win-back email fires (7 days after status
  // flips to expired), same dedupe idiom as expiryWarningSentAt. Cleared
  // on reactivation so a future churn gets its own fresh win-back attempt.
  winbackSentAt       DateTime?
  // Set once the "still not renewed" nudge fires (5 days after status
  // flips to expired) - an earlier, distinct touchpoint from winbackSentAt
  // at day 7, not a duplicate of it. Cleared on reactivation.
  renewalNudgeSentAt  DateTime?
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  lessonId    String // Strapi lesson ID
  completed   Boolean   @default(false)
  completedAt DateTime?

  @@unique([userId, lessonId])
}

model Referral {
  id         String    @id @default(cuid())
  referrerId String
  referrer   User      @relation("ReferralsMade", fields: [referrerId], references: [id])
  referredId String    @unique
  referred   User      @relation("ReferralReceived", fields: [referredId], references: [id])
  status     String    @default("pending") // pending | completed
  rewardedAt DateTime?
  createdAt  DateTime  @default(now())
  // Set once the stale-referral nudge fires (7 days pending, still
  // unconverted) - same sentAt-dedupe idiom as every other flow. Never
  // cleared, since a referral only transitions pending -> completed once
  // and there is no "un-completing" to reset it for.
  nudgeSentAt DateTime?
}

model Organization {
  id             String            @id @default(cuid())
  name           String
  type           String            @default("company")
  email          String            @unique
  adminUserId    String            @unique
  licenseKey     String            @unique @default(cuid())
  createdAt      DateTime          @default(now())
  license        CorporateLicense?
  members        OrgMember[]
  advisorProfile AdvisorProfile?
}

model CorporateLicense {
  id                String       @id @default(cuid())
  orgId             String       @unique
  org               Organization @relation(fields: [orgId], references: [id])
  tier              String       @default("premium")
  seats             Int
  seatsUsed         Int          @default(0)
  status            String       @default("active")
  currentPeriodEnd  DateTime
  paymentMethod     String       @default("paystack") // paystack | offline
  paystackReference String? // set only when paymentMethod = paystack
  offlineReference  String? // invoice #, bank txn ref, etc - set only when paymentMethod = offline
  amountKes         Int
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  // Same dedupe idiom as Subscription.expiryWarningSentAt - the existing
  // subscription-expiry cron never covered corporate licenses, so this had
  // no reminder at all before the lifecycle module added one.
  expiryWarningSentAt DateTime?
}

model OrgMember {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id])
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id])
  role           String       @default("member")
  inviteToken    String?      @unique
  inviteAccepted Boolean      @default(false)
  joinedAt       DateTime     @default(now())
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model Lead {
  id            String    @id @default(cuid())
  email         String
  name          String?
  // Slug of the lead-magnet from Strapi (e.g. "free-chapter"). Determines
  // which PDF the user gets.
  magnetSlug    String
  // Where the visitor was when they submitted (e.g. "/", "/investor-profiler").
  source        String?
  // Referral code present in the URL or cookie at capture time.
  referralCode  String?
  // UTM attribution from the inbound URL.
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmTerm       String?
  utmContent    String?
  // How many times the user has clicked the download link in the success page.
  downloadCount Int       @default(0)
  downloadedAt  DateTime?
  // Marks leads who later registered for an account (set by the auth service
  // when it matches a register email against a recent Lead).
  convertedAt   DateTime?
  createdAt     DateTime  @default(now())

  // A given email captures once per magnet - re-submitting just updates the
  // existing record (avoids duplicate rows when users hit refresh / retry).
  @@unique([email, magnetSlug])
  @@index([magnetSlug, createdAt])
  @@index([createdAt])
}

model StockPrice {
  id        String   @id @default(cuid())
  ticker    String
  name      String
  price     Float
  volume    String
  change    String
  timestamp DateTime @default(now())

  @@index([ticker])
  @@index([timestamp])
}

model Broker {
  id          String   @id @default(cuid())
  name        String   @unique
  cdaCode     String?  @unique // CDSC custodian/agent code, e.g. "B12", "EQBC". Null for non-CDS brokers.
  feePercent  Float // flat all-in commission + levies, e.g. 1.85 for 1.85%
  cdsRequired Boolean  @default(true) // false for Ziidi Trader and similar non-CDS platforms
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  trades        Trade[]
  holdings      Holding[]
  dividends     Dividend[]
  realizedGains RealizedGain[]
}

model Holding {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  brokerId    String
  broker      Broker   @relation(fields: [brokerId], references: [id])
  ticker      String
  companyName String?
  quantity    Int      @default(0)
  avgCost     Float? // average price per share; null until priced trades exist
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([userId, brokerId, ticker])
  @@index([userId])
}

model Trade {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  brokerId      String
  broker        Broker        @relation(fields: [brokerId], references: [id])
  ticker        String
  companyName   String?
  side          String // BUY | SELL
  quantity      Int
  pricePerShare Float
  feesKes       Float         @default(0) // computed from broker.feePercent at entry time, editable
  totalKes      Float // quantity * pricePerShare (+/- feesKes depending on side)
  tradeDate     DateTime
  notes         String?
  source        String        @default("MANUAL") // MANUAL | CDSC_IMPORT
  createdAt     DateTime      @default(now())
  gainRecord    RealizedGain?

  @@index([userId])
  @@index([userId, ticker])
}

model StatementImport {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  filename     String
  accountNo    String?
  periodStart  DateTime?
  periodEnd    DateTime?
  holdingsRead Int       @default(0) // number of ticker/broker positions parsed
  status       String    @default("completed") // completed | failed
  error        String?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

model PriceAlert {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  ticker      String
  targetPrice Float
  direction   String // ABOVE | BELOW
  status      String    @default("pending") // pending | triggered | cancelled
  createdAt   DateTime  @default(now())
  triggeredAt DateTime?

  @@index([userId])
  @@index([ticker, status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String // e.g. "PRICE_ALERT" - kept generic for future reuse
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model Dividend {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  brokerId    String
  broker      Broker   @relation(fields: [brokerId], references: [id])
  ticker      String
  companyName String?
  amountKes   Float // net amount received, post-withholding-tax
  paymentDate DateTime
  source      String   @default("MANUAL") // MANUAL | CDSC_IMPORT
  notes       String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([userId, ticker])
}

model RealizedGain {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  tradeId         String   @unique
  trade           Trade    @relation(fields: [tradeId], references: [id])
  brokerId        String
  broker          Broker   @relation(fields: [brokerId], references: [id])
  ticker          String
  companyName     String?
  quantity        Int
  proceedsKes     Float // quantity * sellPrice - sellFees
  costBasisKes    Float // quantity * avgCost at time of sale
  realizedGainKes Float // proceedsKes - costBasisKes
  tradeDate       DateTime // denormalized from Trade.tradeDate for period queries
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([userId, tradeDate])
  @@index([userId, ticker])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model AdvisorProfile {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id])
  orgId          String?       @unique
  org            Organization? @relation(fields: [orgId], references: [id])
  headline       String
  bio            String
  specialties    String[]      @default([])
  credentials    String?
  photoUrl       String?
  isPublic       Boolean       @default(true)
  isActive       Boolean       @default(true)
  approvalStatus String        @default("pending") // pending | approved | suspended
  approvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  clients     AdvisorClient[]
  queries     AdvisorQuery[]
  insights    AdvisorInsight[]
  alerts      AdvisorAlert[]
}

model AdvisorClient {
  id          String         @id @default(cuid())
  advisorId   String
  advisor     AdvisorProfile @relation(fields: [advisorId], references: [id])
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  status      String         @default("pending") // pending | accepted | declined
  source      String         @default("request") // request | org_member
  requestedAt DateTime       @default(now())
  respondedAt DateTime?

  @@unique([advisorId, userId])
  @@index([userId])
  @@index([advisorId, status])
}

model AdvisorQuery {
  id        String                @id @default(cuid())
  advisorId String
  advisor   AdvisorProfile        @relation(fields: [advisorId], references: [id])
  userId    String
  user      User                  @relation(fields: [userId], references: [id])
  subject   String // first message's text, truncated - used for list previews
  status    String                @default("open") // open (client waiting on advisor) | answered (advisor replied last)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  messages  AdvisorQueryMessage[]

  @@index([advisorId, status])
  @@index([userId])
}

model AdvisorQueryMessage {
  id         String       @id @default(cuid())
  queryId    String
  query      AdvisorQuery @relation(fields: [queryId], references: [id])
  senderRole String // client | advisor
  body       String
  createdAt  DateTime     @default(now())

  @@index([queryId, createdAt])
}

model AdvisorInsight {
  id        String         @id @default(cuid())
  advisorId String
  advisor   AdvisorProfile @relation(fields: [advisorId], references: [id])
  title     String
  body      String
  tickers   String[]       @default([])
  emailedAt DateTime?
  createdAt DateTime       @default(now())

  @@index([advisorId, createdAt])
}

model AdvisorAlert {
  id             String         @id @default(cuid())
  advisorId      String
  advisor        AdvisorProfile @relation(fields: [advisorId], references: [id])
  ticker         String
  action         String // BUY | SELL
  message        String
  recipientCount Int            @default(0)
  createdAt      DateTime       @default(now())

  @@index([advisorId, createdAt])
}

// One row per admin broadcast email send - Brevo owns delivery, this table
// is purely a local history so the CMS can show past campaigns without
// needing Brevo API access from the admin panel.
model BroadcastCampaign {
  id             String    @id @default(cuid())
  brevoCampaignId Int?
  subject        String
  htmlContent    String
  tier           String? // free | intermediary | premium | null (all users)
  audienceCount  Int
  failedCount    Int       @default(0)
  createdAt      DateTime  @default(now())
}

// A named marketing segment (e.g. "engaged-free", "high-value-trader").
// Real Postgres rows rather than Brevo contact attributes, so cron jobs and
// the admin broadcast tool can query "who has tag X" without a Brevo API
// round-trip - Brevo stays the delivery layer, this stays the system of
// record, same division of responsibility as Subscription.tier already has.
model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  users     UserTag[]
}

model UserTag {
  userId  String
  tagId   String
  addedAt DateTime @default(now())
  // Who/what applied this tag, e.g. "system:lesson-engagement" or
  // "admin:manual" - lets the admin UI distinguish automated tags from
  // ones a human applied by hand.
  addedBy String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag     Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userId, tagId])
}

// One row per user per engagement flow, written the moment a user becomes
// eligible for that flow (not just when the email happens to send) - this
// is what makes the funnel visualization and campaign reporting possible.
// Before this, entry was purely implicit: each cron re-derived "who
// qualifies today" from date math and a sentAt flag, with no persisted
// record of when someone actually entered a flow or what happened to them.
//
// `flow` values match the LifecycleFlow enum in lifecycle.service.ts:
// day1-nurture | day7-nurture | day14-nurture | engaged-free-tagging |
// corporate-expiry-warning | winback
model FlowEntry {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flow        String
  enteredAt   DateTime  @default(now())
  // Null while pending (queued for the next cron pass that acts on it);
  // set the moment the flow's terminal action succeeds (email sent, tag
  // applied). completedAt without outcome='sent' would be a contradiction -
  // outcome is the source of truth, completedAt is just its timestamp.
  completedAt DateTime?
  outcome     String    @default("pending") // pending | sent | skipped | failed
  // Flow-specific context for the funnel/reporting UI - e.g. which
  // CorporateLicense id for corporate-expiry-warning, or the lesson count
  // that triggered engaged-free-tagging. Optional, never required to
  // interpret the row.
  metadata    Json?
  // Set from the Brevo transactional-webhook listener (see BrevoWebhookService)
  // when the corresponding "opened"/"click" event arrives for this send's
  // tag. Null forever for a row nobody engaged with - that's a real, visible
  // funnel outcome (sent but ignored), not missing data.
  openedAt    DateTime?
  clickedAt   DateTime?
  // The specific link clicked, when Brevo's click event includes one -
  // lets the dashboard show which CTA in a multi-link email actually got
  // clicked, not just that something in it did.
  clickedUrl  String?

  @@index([flow, enteredAt])
  @@index([userId, flow])
}

// One public "daily market report" per NSE trading session. The facts are
// computed from StockPrice; the story/social copy is AI-written (or a
// deterministic template when the AI is unavailable or fails numeric
// verification) and checked against those facts before it is saved.
model MarketReport {
  id          String    @id @default(cuid())
  sessionDate String    @unique // YYYY-MM-DD, the Nairobi trading day covered
  status      String    @default("published") // published | unpublished
  facts       Json
  story       Json // headline, summary, story[], lessons[]
  social      Json // xPost, xThread, whatsapp, reel, caption, hashtags
  aiGenerated Boolean   @default(false)
  aiModel     String?
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([status, sessionDate])
}
